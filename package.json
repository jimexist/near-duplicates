{
  "name": "near-duplicates",
  "version": "0.2.3",
  "description": "A TypeScript npm package for finding near duplicate string pairs",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf ./dist/",
    "test": "vitest",
    "format": "oxfmt ./src ./test",
    "lint": "oxlint ./src ./test",
    "check": "oxfmt --check ./src ./test && oxlint ./src ./test",
    "bench": "vitest bench",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimexist/near-duplicates.git"
  },
  "keywords": [
    "duplicates",
    "ukkonen",
    "string-deduplication",
    "levenshtein"
  ],
  "author": {
    "name": "Jiayu Liu",
    "url": "https://github.com/jimexist"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/jimexist/near-duplicates/issues"
  },
  "homepage": "https://github.com/jimexist/near-duplicates#readme",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "fastest-levenshtein": "^1.0.16",
    "oxfmt": "0.52.0",
    "oxlint": "1.67.0",
    "tsdown": "^0.22.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "xxh3-ts": "^2.0.1"
  }
}
